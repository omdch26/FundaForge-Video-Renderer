# Secrets — never commit
.env
*.key
client_secret*.json
token*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node / Remotion
node_modules/
remotion/node_modules/
.remotion/

# Generated output — regenerable, and large
out/
!out/.gitkeep

# Generated media assets (tracked by hash in out/, not by git)
assets/music/*.mp3
assets/music/*.wav
!assets/music/.gitkeep

# OS
Thumbs.db
.DS_Store
